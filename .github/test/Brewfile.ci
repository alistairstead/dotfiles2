# Minimal Brewfile for CI testing
# Only essential tools needed for dotfiles functionality

# Core utilities
brew "coreutils"
brew "git"
brew "stow"

# Shell and terminal tools
# zsh and bash come with macOS; the real Brewfile does not install them either,
# so CI exercises the same versions this repo runs against.
brew "starship"
brew "direnv"
brew "zoxide"
brew "fzf"
brew "bat"
brew "eza"
brew "ripgrep"
brew "fd"

# Development tools
brew "mise"
brew "neovim"
brew "tmux"
brew "gh"

# Optional but useful for testing
brew "jq"
brew "yq"