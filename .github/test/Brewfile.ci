# Minimal Brewfile for CI testing
# Only essential tools needed for dotfiles functionality

# Core utilities
brew "coreutils"
brew "git"
brew "stow"

# Shell and terminal tools
# zsh and bash come with macOS; the real Brewfile does not install them either,
# so CI exercises the same versions this repo runs against.
brew "starship"

# Zsh plugins, so the .zshrc load test covers the real configuration.
# zsh-abbr is omitted: it lives in olets/tap, and third-party taps need
# explicit trust that CI does not grant. The abbr block in .zshrc is guarded,
# so CI exercises the same path a machine hits before the tap is trusted.
brew "zsh-syntax-highlighting"
brew "zsh-completions"
brew "zsh-autosuggestions"
brew "fzf-tab"

# atuin owns ctrl-r and the up arrow, and .zshrc calls it twice: pty-proxy on
# the first line and `atuin init` near the last. Both are guarded on the binary
# existing, so without this the load test silently skips the whole integration.
brew "atuin"
brew "direnv"
brew "zoxide"
brew "fzf"
brew "bat"
brew "eza"
brew "ripgrep"
brew "fd"

# Development tools
brew "mise"
brew "neovim"
brew "gh"
brew "jj"

# Optional but useful for testing
brew "jq"
brew "yq"