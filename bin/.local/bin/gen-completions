#!/usr/bin/env bash
# Generate zsh completions for tools that ship a generator but no packaged
# completion file.
#
# Homebrew formulae normally drop a _tool into share/zsh/site-functions and
# carapace covers another ~650 commands. What is left is tools that can emit a
# completion but expect you to ask. Doing that at shell start would mean a
# subprocess fork per tool on every prompt, and uv and opencode are slow to
# start, so the output is cached here instead and picked up via fpath.
#
# Run after installing or upgrading any of these:
#   gen-completions
#
# Wired into install.sh and the `update` script, so it usually runs on its own.

set -uo pipefail

DEST="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
mkdir -p "$DEST"

generated=0
skipped=0
changed=0

# Move $1 into place, but only if it differs from what is already there.
# Tracking that is what keeps a no-op run from deleting .zcompdump and making
# every shell afterwards pay for a full rebuild.
install_file() {
  local src=$1 name=$2

  if cmp -s "$src" "$DEST/$name"; then
    rm -f "$src"
  else
    mv "$src" "$DEST/$name"
    chmod 644 "$DEST/$name" # mktemp gives 600; keep the directory uniform
    changed=1
  fi
  generated=$((generated + 1))
}

# Write stdout of a generator to $DEST/$1, but only if it produced something.
# A failed generator that leaves a truncated file behind is worse than no file:
# compinit -C would cache the stub and the command would complete to nothing.
emit() {
  local name=$1 tool=$2
  shift 2

  if ! command -v "$tool" >/dev/null 2>&1; then
    skipped=$((skipped + 1))
    return 0
  fi

  local tmp
  tmp=$(mktemp) || return 1
  if "$@" >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    install_file "$tmp" "$name"
  else
    rm -f "$tmp"
    echo "⚠️  $tool produced no completion; left $DEST/$name alone"
  fi
}

emit _uv uv uv generate-shell-completion zsh
emit _uvx uvx uvx --generate-shell-completion zsh
emit _railway railway railway completion zsh

# opencode ships a broken guard. Its yargs template emits
#
#   if [[ "'${zsh_eval_context[-1]}" == "loadautofunc" ]]; then
#
# and that stray quote makes the comparison "'loadautofunc" == "loadautofunc",
# which is never true. Autoloaded, the file therefore takes the else branch,
# re-runs compdef and returns without completing anything: the first tab press
# does nothing and only the second works.
#
# Strip the quote, then refuse to install if it is still there, so an upstream
# template change shows up as a loud failure rather than a dead tab key.
if command -v opencode >/dev/null 2>&1; then
  tmp=$(mktemp)
  if opencode completion zsh >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    # Drop the quote, on the guard line only. The '"'"' dance is just a single
    # quote inside a single-quoted string; bash parameter substitution was the
    # obvious alternative and mangles the nested quotes.
    sed '/zsh_eval_context/s/"'"'"'/"/' "$tmp" >"$tmp.fixed" && mv "$tmp.fixed" "$tmp"

    # Assert the repaired line is present, not merely that the broken one is
    # gone — a substitution that mangles the text satisfies the weaker test.
    if grep -qF '"${zsh_eval_context[-1]}" == "loadautofunc"' "$tmp"; then
      install_file "$tmp" _opencode
    else
      echo "⚠️  opencode: unrecognised completion template, not installed"
      rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
    echo "⚠️  opencode produced no completion; left $DEST/_opencode alone"
  fi
else
  skipped=$((skipped + 1))
fi

# granted is the awkward one. `granted completion --shell zsh` does not print to
# stdout: it writes _assume and _granted under ~/.granted/zsh_autocomplete and
# then appends absolute fpath=(...) lines to ~/.zshenv. Here ~/.zshenv is a stow
# symlink into this repo, so running it unsandboxed would edit a tracked file.
#
# Running it against a throwaway HOME gets the two generated files without the
# side effect. They are portable: each is a small wrapper that shells out to
# assumego, with no path baked in.
#
# _assume is worth keeping even though `assume` is an alias for `. assume`.
# Alias expansion usually means an alias name never reaches its own completer,
# so this one looks like it should be dead. It is not: `assume <TAB>` lists the
# real AWS profiles.
#
# If it ever does stop working, COMPLETE_ALIASES is not the answer. It is off,
# which is both the zsh default and what this setup wants: with it off an alias
# completes as its target, which is why ll completes as eza, vim as nvim, rm as
# trash and mr/mi/mu/mc as mise. Turning it on trades all of those for this one.
if command -v granted >/dev/null 2>&1; then
  sandbox=$(mktemp -d) || exit 1
  if HOME="$sandbox" granted completion --shell zsh >/dev/null 2>&1; then
    for pair in "assume:_assume" "granted:_granted"; do
      src="$sandbox/.granted/zsh_autocomplete/${pair%%:*}/${pair##*:}"
      [ -s "$src" ] && install_file "$src" "${pair##*:}"
    done
  else
    echo "⚠️  granted completion failed; left _assume and _granted alone"
  fi
  rm -rf "$sandbox"
else
  skipped=$((skipped + 2))
fi

# compinit runs with -C, which trusts the cached dump and never rescans fpath.
# Without dropping it, everything above stays invisible until the dump happens
# to be rebuilt for some other reason. Only when something actually changed,
# though: this runs on every `update`, and an unconditional delete would make
# the next shell after every update pay for a full fpath scan for nothing.
#
# The glob also clears the stale .zcompdump.<host>.* siblings zsh leaves behind.
if [ "$changed" -eq 1 ]; then
  rm -f "$HOME"/.zcompdump*
  echo "✅ $generated completions in $DEST ($skipped absent); next new shell rebuilds .zcompdump"
else
  echo "✅ $generated completions in $DEST ($skipped absent); unchanged"
fi
