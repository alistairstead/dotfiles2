{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "opus",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoDreamEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(jj commit:*) in ~/dev/personal/dotfiles",
      "Bash(shellcheck:*) in ~/dev/personal/dotfiles",
      "Bash(stow:*) in ~/dev/personal/dotfiles"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — alistairstead/dotfiles2 (github.com), default branch main",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default); no branch protection rules or rulesets listed via gh — treat as unprotected",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (alistairstead/dotfiles2 on github.com) and its remote only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: personal dotfiles / environment configuration (hobby use)",
      "**Trusted repo**: /Users/alistairstead/dev/personal/dotfiles, remote github.com:alistairstead/dotfiles2.git — PUBLIC repo: only this repo's own work belongs here; content ported from elsewhere is not cleared for commit/push just because this repo is public",
      "**Org-specific CLIs**: None configured — this repo's docs reference jj (used instead of git per user CLAUDE.md), stow, mise, brew, shellcheck as routine project tooling",
      "routine under ~/dev/personal/dotfiles/ prefix: stow/jj/shellcheck/mise/brew invocations, ./install.sh, karabiner pnpm build"
    ]
  },
  "editorMode": "vim",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "dev-browser@dev-browser-marketplace": true,
    "fallow@fallow-skills": true,
    "feature-dev@claude-plugins-official": false,
    "figma@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "USE_BUILTIN_RIPGREP": "1"
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "repo": "mksglu/context-mode",
        "source": "github"
      }
    },
    "fallow-skills": {
      "source": {
        "repo": "fallow-rs/fallow-skills",
        "source": "github"
      }
    },
    "obsidian-skills": {
      "source": {
        "repo": "kepano/obsidian-skills",
        "source": "github"
      }
    }
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754066916309
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notifications.ts",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jj claude-snapshot >> /tmp/claude-snapshot.log 2>&1 || true",
            "type": "command"
          }
        ],
        "matcher": "Task"
      },
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notifications.ts",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "jj claude-checkpoint || true",
            "type": "command"
          }
        ],
        "matcher": "Task"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/pre-use-tool.ts",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "jj claude-snapshot  >> /tmp/claude-snapshot.log 2>&1 || true",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notifications.ts",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notifications.ts",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "git worktree add -b \"worktree-$(basename \"$1\")\" \"$1\" origin/main",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(source:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(tree:*)",
      "Bash(touch:*)",
      "Bash(cat:*)",
      "Bash(bun vitest:*)",
      "Bash(bun run test:*)",
      "Bash(bun turbo:*)",
      "Bash(jj log *)",
      "Bash(jj diff *)",
      "Bash(jj status)",
      "Bash(jj root)",
      "Bash(bunx tsc *)",
      "Bash(mise list *)",
      "mcp__pencil",
      "Edit(.env.schema)",
      "Edit(**/.env.schema)",
      "Read(.env.schema)",
      "Read(**/.env.schema)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.local)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.cert)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)"
    ]
  },
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "sh $HOME/.claude/statusline-command.sh",
    "type": "command"
  },
  "teammateMode": "in-process",
  "terminalProgressBarEnabled": true,
  "theme": "dark",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "voiceEnabled": false,
  "worktree": {
    "baseRef": "fresh"
  }
}