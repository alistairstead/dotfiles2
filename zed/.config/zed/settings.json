{
  // ---------------------------------------------------------------------------
  // Editor
  // ---------------------------------------------------------------------------
  "vim_mode": true,
  "base_keymap": "VSCode",
  "diff_view_style": "unified",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "cursor_shape": "underline",
  "cursor_blink": false,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "text_rendering_mode": "platform_default",
  "cli_default_open_behavior": "existing_window",
  "code_lens": "on",
  "colorize_brackets": true,
  "middle_click_paste": false,
  "lsp_document_colors": "background",
  "completion_menu_scrollbar": "auto",
  "use_auto_surround": true,
  "use_on_type_format": true,
  "inline_code_actions": true,
  "use_system_prompts": true,
  "close_on_file_delete": true,
  "always_treat_brackets_as_autoclosed": false,
  "restore_on_startup": "last_workspace",
  "buffer_line_height": "comfortable",
  "minimum_contrast_for_highlights": 65.0,
  "show_completion_documentation": true,
  "auto_signature_help": true,
  "autoscroll_on_clicks": false,
  "show_wrap_guides": false,
  "current_line_highlight": "gutter",
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 5,
  "snippet_sort_order": "bottom",
  "drag_and_drop_selection": {
    "enabled": false
  },
  "completions": {
    "lsp_insert_mode": "replace_subsequence"
  },
  "inlay_hints": {
    "show_parameter_hints": true,
    "show_type_hints": true,
    "show_other_hints": false,
    "show_value_hints": true,
    "show_background": false,
    "enabled": true
  },
  "indent_guides": {
    "enabled": false,
    "coloring": "indent_aware"
  },
  // Mouse-hover popovers stay out of the way, but the delay is long enough that
  // `K` (editor::Hover) still works -- the keyboard hover path is gated on this
  // same flag, so it cannot be `false`.
  "hover_popover_enabled": true,
  "hover_popover_delay": 1000,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  // The default number of lines to expand excerpts in the multibuffer by.
  "expand_excerpt_lines": 10,
  // The default number of context lines shown in multibuffer excerpts.
  "excerpt_context_lines": 10,

  // ---------------------------------------------------------------------------
  // Vim
  // ---------------------------------------------------------------------------
  "vim": {
    // "always" also routes every delete/change through the system clipboard.
    // Set back to "always" if you miss that.
    "use_system_clipboard": "on_yank",
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
    "custom_digraphs": {}
  },

  // ---------------------------------------------------------------------------
  // Appearance
  // ---------------------------------------------------------------------------
  "theme": {
    "mode": "dark",
    "light": "Zedokai Light (Filter Sun)",
    "dark": "Zedokai Darker (Filter Spectrum)"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_weight": 200.0,
  "ui_font_size": 16,
  "agent_ui_font_size": 16.0,
  "agent_buffer_font_size": 14.0,
  "buffer_font_size": 14,
  "buffer_font_family": "Victor Mono",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "buffer_font_weight": 300.0,
  "buffer_font_features": {
    "liga": true,
    "calt": true,
    "kern": true
  },
  "active_pane_modifiers": {
    // Inset border size of the active pane, in pixels.
    "border_size": 1.0,
    // Opacity of the inactive panes. 0 means transparent, 1 means opaque.
    // Values are clamped to the [0.0, 1.0] range.
    "inactive_opacity": 0.6
  },
  "image_viewer": {
    "unit": "decimal"
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "full",
  "confirm_quit": true,
  "zoomed_padding": false,
  "which_key": {
    "delay_ms": 500,
    "enabled": true
  },

  // ---------------------------------------------------------------------------
  // Panels, docks and chrome
  // ---------------------------------------------------------------------------
  "status_bar": {
    "show_active_file": true
  },
  "toolbar": {
    "selections_menu": false,
    "agent_review": false,
    "breadcrumbs": false,
    "quick_actions": false
  },
  "title_bar": {
    "show_branch_name": false,
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_sign_in": true
  },
  "scrollbar": {
    "diagnostics": "none",
    "show": "never",
    "axes": {
      "horizontal": false,
      "vertical": false
    }
  },
  "tabs": {
    "show_diagnostics": "errors",
    "git_status": true
  },
  "preview_tabs": {
    "enabled": false
  },
  "git_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right",
    "auto_reveal_entries": false,
    "auto_fold_dirs": false
  },
  "project_panel": {
    "dock": "right",
    "hide_gitignore": false,
    "hide_root": true,
    "drag_and_drop": true,
    "sticky_scroll": false,
    "auto_fold_dirs": false,
    "starts_open": false,
    "auto_reveal_entries": true
  },

  // ---------------------------------------------------------------------------
  // Search and file finder
  // ---------------------------------------------------------------------------
  "search": {
    "center_on_match": true,
    // Left at the defaults: `case_sensitive: true` would make
    // `use_smartcase_search` below a no-op, and `whole_word: true` silently
    // hides substring matches in every project search.
    "case_sensitive": false,
    "whole_word": false,
    "include_ignored": false
  },
  "seed_search_query_from_cursor": "always",
  "use_smartcase_search": true,
  "file_finder": {
    "modal_max_width": "large",
    // Can accept 3 values:
    //   * "all":     use all gitignored files
    //   * "indexed": use only the files Zed has indexed
    //   * "smart":   search ignored files when called from a gitignored worktree
    "include_ignored": "indexed"
  },

  // ---------------------------------------------------------------------------
  // Formatting and language servers
  // ---------------------------------------------------------------------------
  "format_on_save": "on",
  "formatter": "language_server",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "autosave": "off",
  "enable_language_server": true,
  "use_autoclose": true,
  "tasks": {
    "prefer_lsp": true
  },
  "load_direnv": "shell_hook",
  // Biome covers JS/TS/JSON/CSS. Prettier is left enabled so Markdown and YAML
  // still format on save -- Biome has no stable support for either.
  "prettier": {
    "allowed": true
  },
  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true
      }
    },
    "JSONC": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true
      }
    },
    "CSS": { "formatter": { "language_server": { "name": "biome" } } },
    "Markdown": { "formatter": "prettier" },
    "YAML": { "formatter": "prettier" }
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "vtsls": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true
        }
      },
      "settings": {
        "typescript": {
          "tsserver": { "maxTsServerMemory": 16384 },
          "updateImportsOnFileMove": { "enabled": "always" },
          "suggest": {
            "completeFunctionCalls": true
          },
          "inlayHints": {
            "parameterNames": { "enabled": "all" },
            "parameterTypes": { "enabled": true },
            "variableTypes": { "enabled": true },
            "propertyDeclarationTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true }
          }
        }
      }
    }
  },

  // ---------------------------------------------------------------------------
  // Git
  // ---------------------------------------------------------------------------
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },

  // ---------------------------------------------------------------------------
  // AI
  // ---------------------------------------------------------------------------
  "edit_predictions": {
    "provider": "copilot"
  },
  "show_edit_predictions": true,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "agent": {
    "dock": "left",
    "thinking_display": "preview",
    "show_turn_stats": true,
    "message_editor_min_lines": 6,
    "expand_terminal_card": false,
    "expand_edit_card": true,
    "single_file_review": true,
    "play_sound_when_agent_done": "always",
    "default_profile": "write",
    // Zed's default. "allow" auto-approves `terminal` and `edit_file` with no
    // prompt, in every project.
    "tool_permissions": {
      "default": "confirm"
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4"
    },
    "model_parameters": [],
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    }
  },
  "context_servers": {},

  // ---------------------------------------------------------------------------
  // Terminal
  // ---------------------------------------------------------------------------
  "terminal": {
    "bell": "system",
    "font_weight": 100,
    "font_size": 14,
    "font_family": "Victor Mono",
    "line_height": "standard",
    // Whether selecting text in the terminal copies to the system clipboard.
    "copy_on_select": true,
    "button": true,
    "toolbar": {
      "breadcrumbs": true
    },
    "default_height": 320
  },

  // ---------------------------------------------------------------------------
  // Misc
  // ---------------------------------------------------------------------------
  "calls": {
    "mute_on_join": true
  },
  "ssh_connections": [
    {
      "host": "192.168.0.187",
      "username": "hassio",
      "args": [],
      "projects": [{ "paths": ["/./"] }, { "paths": ["/home/hassio"] }],
      "nickname": "Homeassistant"
    }
  ]
}
